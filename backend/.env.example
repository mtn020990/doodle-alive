# Copy to backend/.env and fill in what you need. Everything is optional:
# with no keys at all the app still works end-to-end using the "mock" animator.

# --- Which animator runs for each mode -----------------------------------
# scene     = anything that is not a human-like figure (rocket, cat, house...)
# character = a human-like figure with head/body/arms/legs
#   mock              -> offline Pillow wobble GIF (always works, instant)
#   hf_space          -> image-to-video on a Hugging Face Space (Wan 2.2 / LTX)
#   animated_drawings -> Meta AnimatedDrawings (local install, see docs/PLAN.md)
SCENE_ANIMATOR=mock
CHARACTER_ANIMATOR=mock

# --- Hugging Face Space (image-to-video) ---------------------------------
# Run `python scripts/inspect_space.py` to see the Space's real API and
# parameter names, then set them here.
HF_TOKEN=
HF_SPACE_ID=Wan-AI/Wan-2.2-5B
HF_API_NAME=/generate_video
HF_IMAGE_PARAM=image
HF_PROMPT_PARAM=prompt
# Extra keyword args as JSON, e.g. {"duration_seconds": 3}
HF_EXTRA_PARAMS={}

# --- Meta AnimatedDrawings (character mode) -------------------------------
# Folder where https://github.com/facebookresearch/AnimatedDrawings is cloned,
# and the python.exe of the env it is installed in.
AD_REPO_DIR=
AD_PYTHON=python

# --- Claude: describe the drawing + write the motion prompt --------------
# Leave empty to skip; a generic prompt is used instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
