# Copy to backend/.env and fill in what you need. Everything is optional:
# with no keys at all the app still works end-to-end using the "mock" animator.

# --- Which animator runs for each mode -----------------------------------
# scene     = anything that is not a human-like figure (rocket, cat, house...)
# character = a human-like figure with head/body/arms/legs
#   mock              -> offline Pillow wobble GIF (always works, instant)
#   hf_space          -> image-to-video on a Hugging Face Space (Wan 2.2 / LTX)
#   animated_drawings -> Meta AnimatedDrawings (local install, see docs/PLAN.md)
#   animated_drawings_api -> Meta AnimatedDrawings as a service (character-service/,
#                        deployed with scripts/deploy-azure.ps1 -Part character)
SCENE_ANIMATOR=mock
CHARACTER_ANIMATOR=mock

# --- Hugging Face Space (image-to-video) ---------------------------------
# Verified 2026-10-05: Lightricks/ltx-video-distilled (LTX-Video, fast). For another
# Space, run `python scripts/inspect_space.py <space-id>` to see its real API and
# parameter names, then set them here.
HF_TOKEN=
# Team keys, tried in turn when one runs out of free GPU quota (name:token, comma-separated).
# Overrides HF_TOKEN. Status + manual switching: open the page with #admin at the end.
HF_TOKENS=
# Own free GPU servers, tried after all HF keys (notebooks/ltx_gpu_server.ipynb on
# Kaggle / Colab). Usually pasted in the admin panel instead: the links change on restart.
GPU_SERVERS=
HF_SPACE_ID=Lightricks/ltx-video-distilled
HF_API_NAME=/image_to_video
HF_IMAGE_PARAM=input_image_filepath
HF_PROMPT_PARAM=prompt
# Extra keyword args as JSON, e.g. {"duration_seconds": 3}
HF_EXTRA_PARAMS={"mode": "image-to-video", "duration_ui": 2}

# --- Meta AnimatedDrawings (character mode) -------------------------------
# Folder where https://github.com/facebookresearch/AnimatedDrawings is cloned,
# and the python.exe of the env it is installed in.
AD_REPO_DIR=
AD_PYTHON=python
# Or the AnimatedDrawings service (animated_drawings_api). On Azure the deploy
# script fills AD_SERVICE_URL in. Motion: dab | jumping | wave_hello | zombie |
# jumping_jacks | random
AD_SERVICE_URL=
AD_MOTION=random

# --- Claude: describe the drawing + write the motion prompt --------------
# Leave empty to skip; a generic prompt is used instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Gemini (free alternative to Claude for the same step) ----------------
# Free key, no credit card: https://aistudio.google.com/apikey
# Used only when ANTHROPIC_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Hosting ---------------------------------------------------------------
# Comma-separated sites allowed to call this API when the frontend is hosted
# elsewhere. scripts/deploy-azure.ps1 adds the Azure frontend URL automatically.
CORS_ORIGINS=
# PIN for the admin panel (page URL + #admin). Use 6+ digits. Empty = admin switched off.
ADMIN_PIN=
